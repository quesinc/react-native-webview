# appium's dependency tree downloads binaries on install that nothing here uses: a chromedriver (whose download
# also crashes once @xmldom/xmldom 0.9 is resolved) and, via puppeteer, Chrome for Testing. Skip both. This also
# covers the full install yarn v1 runs to `prepare` this repo when an app depends on it via git.
chromedriver-skip-install true
puppeteer-skip-download true
